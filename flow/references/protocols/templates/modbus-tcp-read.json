  {
    "id": "function_{{FLOW_ID}}",
    "type": "function",
    "z": "tab_{{FLOW_ID}}",
    "name": "Map to UNS payload",
    "func": "// msg.payload is the Modbus response object:\n//   msg.payload.data  — array of register/coil values\n//   msg.payload.buffer — raw Buffer\nvar registers = Array.isArray(msg.payload) ? msg.payload : msg.payload.data;\nif (!Array.isArray(registers)) {\n  node.warn(\"Unexpected Modbus payload\");\n  return null;\n}\n\n// Build one object matching the target UNS topic fields.\n// TODO: replace field names and indices to match your UNS topic schema.\n// Example: msg.payload = { temperature: registers[0] * 0.1 };\n{{FUNCTION_BODY}}\n\nif (!msg.payload || typeof msg.payload !== \"object\" || Array.isArray(msg.payload)) {\n  node.warn(\"UNS MQTT payload must be an object\");\n  return null;\n}\nmsg.topic = \"{{UNS_TOPIC}}\";\nmsg.payload = JSON.stringify(msg.payload);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 160,
